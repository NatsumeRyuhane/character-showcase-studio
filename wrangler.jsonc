{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "character-showcase-studio",
  "account_id": "a283fed3fc5ff0674320a74800643614",
  "main": "tools/cloudflare-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [
    { "pattern": "nekokaii.com/showcase-generator", "zone_name": "nekokaii.com" },
    { "pattern": "nekokaii.com/showcase-generator/*", "zone_name": "nekokaii.com" }
  ],
  "build": { "command": "node tools/build-cloudflare.mjs" },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
