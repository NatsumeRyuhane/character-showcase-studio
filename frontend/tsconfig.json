{
  // Type checking only; Vite does the transpiling. JavaScript is allowed but not
  // yet checked, so modules can move to TypeScript one at a time (issue #3).
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    // Imports name the .ts file, which Vite and Vitest resolve as written.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "runtime/**/*.ts", "tests/unit"]
}
